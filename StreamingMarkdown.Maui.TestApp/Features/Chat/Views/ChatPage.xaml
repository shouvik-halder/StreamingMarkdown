<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:selector="clr-namespace:StreamingMarkdown.Maui.TestApp.Features.Chat.Selectors"
    xmlns:templates="clr-namespace:StreamingMarkdown.Maui.TestApp.Features.Chat.Templates"
    x:Class="StreamingMarkdown.Maui.TestApp.Features.Chat.Views.ChatPage"
    Title="Chat"
    HideSoftInputOnTapped="True"
    BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="UserTemplate">
                <templates:UserMessageTemplate />
            </DataTemplate>

            <DataTemplate x:Key="AssistantTemplate">
                <templates:AssistantMessageTemplate />
            </DataTemplate>

            <selector:ChatMessageTemplateSelector
                x:Key="ChatMessageTemplateSelector"
                AssistantMessageTemplate="{StaticResource AssistantTemplate}"
                UserMessageTemplate="{StaticResource UserTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto"
          RowSpacing="0">

        <!-- Conversation -->
        <CollectionView BackgroundColor="#FAFBFC"
            x:Name="MessagesList"
            Grid.Row="0"
            Margin="0"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            ItemsUpdatingScrollMode="KeepLastItemInView"
            ItemSizingStrategy="MeasureAllItems"
            ItemTemplate="{StaticResource ChatMessageTemplateSelector}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="28"
                    Spacing="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="Start a conversation"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#1E293B" />

                    <Label
                        Text="Send a message to test progressive Markdown rendering."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="#64748B" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Suggested replies, always above the composer -->
        <!-- Suggested replies -->
<FlexLayout BackgroundColor="#FAFBFC"
    x:Name="SuggestedRepliesLayout"
    Grid.Row="1"
    Direction="Row"
    Wrap="Wrap"
    JustifyContent="Start"
    AlignItems="Center"
    AlignContent="Start"
    IsVisible="{Binding HasSuggestedReplies}"
    Padding="8,4" />

        <!-- Fixed composer -->
        <Border
            Grid.Row="2"
            Padding="12" Margin="16, 12, 12, 0"
            BackgroundColor="White"
            Stroke="#D9EAF9"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14">

            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10"
                RowSpacing="8">

                <Entry
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding InputText, Mode=TwoWay}"
                    Placeholder="Message the assistant..."
                    ReturnType="Send"
                    MinimumHeightRequest="44"
                    MaximumHeightRequest="140"
                    BackgroundColor="White"
                    TextColor="#1E293B"
                    PlaceholderColor="#94A3B8" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0" FontFamily="RobotoBold" FontAttributes="Italic"
                    Text="{Binding Status}"
                    FontSize="12"
                    TextColor="#64748B"
                    VerticalOptions="Center" />

                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="8">

                    <Button
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsBusy}"
                        Padding="12,8"
                        CornerRadius="18"
                        BackgroundColor="#F1F5F9"
                        TextColor="#334155" />

                    <Button
                        Text="↑"
                        FontAttributes="Bold"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        CornerRadius="18"
                        BackgroundColor="#1769D2"
                        TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>