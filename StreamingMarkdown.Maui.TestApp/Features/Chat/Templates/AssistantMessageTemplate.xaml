<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markdown="clr-namespace:StreamingMarkdown.Maui.Controls;assembly=StreamingMarkdown.Maui"
             xmlns:styling="clr-namespace:StreamingMarkdown.Maui.Styling;assembly=StreamingMarkdown.Maui"
             x:Class="StreamingMarkdown.Maui.TestApp.Features.Chat.Templates.AssistantMessageTemplate">
    <ContentView.Resources>
        <ResourceDictionary>
            <styling:MarkdownStyle
                x:Key="AssistantMarkdownStyle"
                BodyFontSize="14"
                LineHeight="1.5"
                TextColor="#363B40"/>
        </ResourceDictionary>
    </ContentView.Resources>
    <Border
        HorizontalOptions="Start"
        Margin="16, 8"
        BackgroundColor="Transparent"
        StrokeThickness="0">

        <markdown:MarkdownView MarkdownStyle="{StaticResource AssistantMarkdownStyle}"
            Source="{Binding MarkdownSession}" />
    </Border>
</ContentView>
