<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet -->
    <PackageId>StreamingMarkdown.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>Shouvik Halder</Authors>
    <Description>
      Core incremental Markdown parsing, reconciliation, diffing, and streaming infrastructure.
    </Description>
    <PackageTags>markdown;streaming;incremental;parser;diffing;ai</PackageTags>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

</Project>